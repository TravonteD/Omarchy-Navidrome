[Unit]
Description=Omarchy Navidrome plugin playback backend
After=graphical-session.target sound.target
Wants=sound.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=PULSE_LATENCY_MSEC=30
Environment=TOKIO_WORKER_THREADS=2
ExecStart=%h/.local/lib/omarchy-navidrome/omarchy-navidrome-backend --config-path=%h/.config/omarchy-navidrome/backend.conf
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=75 77 78
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
